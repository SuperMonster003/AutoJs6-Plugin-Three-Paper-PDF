<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="org.autojs.permission.PLUGIN" />

    <!--
        Roadmap D7: script operations receive file descriptors from the host and need no storage permission of the
        plugin; only the standalone toolbox reads and writes the paths you choose, so it asks for all files access on
        Android 11+ and for the legacy storage permissions below.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!--
        Long toolbox tasks run in a data sync foreground service with a progress notification (roadmap D37, P4.1).
        P0.1 only reserves the permissions, the foreground service component comes with P4.1.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- The update check (roadmap D37). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The host (the script entry of roadmap D4 and its bindings). -->
    <queries>
        <package android:name="org.autojs.autojs6" />
    </queries>

    <application
        android:name=".ThreePaperPdfApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_icon_studio_application"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_icon_studio_application"
        android:supportsRtl="true"
        android:theme="@style/Theme.ThreePaperPdf"
        tools:targetApi="33">

        <!--
            The only native library is libandroidx.graphics.path.so of Compose, aligned to 16 KB pages and checked by
            the native alignment gate of the build (roadmap D26, appendix D Q9).
        -->
        <meta-data
            android:name="org.autojs.plugin.contract.NATIVE_PAGE_ALIGNMENT"
            android:value="16384" />

        <meta-data
            android:name="org.autojs.plugin.WAKE_ACTIVITY"
            android:value=".WakeActivity" />

        <meta-data
            android:name="org.autojs.plugin.info.AUTHOR"
            android:value="@string/plugin_author" />

        <activity
            android:name=".WakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.action.WAKE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false"
            android:launchMode="singleTask" />

        <!--
            Launcher icon modes (roadmap D24, P0.2): exactly one alias is enabled at a time; the settings screen of
            roadmap P4.1 switches them through ui.appearance.LauncherIcons. The adaptive automatic mode is the default.
        -->
        <activity-alias
            android:name=".launcher.AdaptiveLightIconAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_system_light"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_system_light"
            android:targetActivity=".ui.home.HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.AdaptiveDarkIconAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_system"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_system"
            android:targetActivity=".ui.home.HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.AdaptiveAutoIconAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_system_auto"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_system_auto"
            android:targetActivity=".ui.home.HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.TransparentIconAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".ui.home.HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
            The viewer (roadmap 5.5, D21, D35): the host starts it with an explicit component, the PDF_VIEWER_OPEN action
            and the session token as the only extra (two-step launch, guarded by the plugin permission); the launcher and
            other apps open PDF files through ACTION_VIEW. singleTop: a new request replaces the document on screen.
        -->
        <activity
            android:name=".viewer.ThreePaperPdfViewerActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="org.autojs.plugin.PDF_VIEWER_OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!--
            The file manager tools (roadmap D36, P3.3), started only by the host through the Explorer Action catalog of
            ThreePaperPdfExplorerActionService with an explicit component and the EXECUTE action: the primary action
            opens the viewer subclass (appendix D Q75), the other tools show their options and progress in
            PdfToolActivity (Q70) and write the result through the host session.
        -->
        <activity
            android:name=".explorer.ExplorerPdfViewerActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:permission="org.autojs.permission.PLUGIN">
            <intent-filter>
                <action android:name="org.autojs.plugin.EXPLORER_ACTION_EXECUTE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".explorer.PdfToolActivity"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="org.autojs.plugin.EXPLORER_ACTION_EXECUTE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Copies of the open document handed to other apps by share and open with (roadmap P3.1), granted per intent.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.viewer.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/viewer_file_paths" />
        </provider>

        <service
            android:name=".service.ThreePaperPdfInfoService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <meta-data
                android:name="requiresHostVersion"
                android:value="@string/plugin_requires_host_version" />
            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
                <category android:name="three-paper-pdf" />
            </intent-filter>
        </service>

        <service
            android:name=".service.ThreePaperPdfService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <meta-data
                android:name="requiresHostVersion"
                android:value="@string/plugin_requires_host_version" />
            <intent-filter>
                <action android:name="org.autojs.plugin.PDF" />
                <category android:name="pdf" />
            </intent-filter>
        </service>

        <service
            android:name=".ThreePaperPdfExplorerActionService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <meta-data
                android:name="requiresHostVersion"
                android:value="@string/plugin_requires_host_version" />
            <intent-filter>
                <action android:name="org.autojs.plugin.EXPLORER_ACTION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

    </application>

</manifest>
